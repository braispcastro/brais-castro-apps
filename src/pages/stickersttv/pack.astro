---
// Landing page for StickersTTV shared pack links (/stickersttv/pack/?v=1&p=…&e=…).
// With the app installed, iOS opens the link in the app (see public/.well-known/apple-app-site-association)
// and this page is never shown. Otherwise it sends the visitor straight to the App Store.

const appStoreUrl = 'https://apps.apple.com/app/id6740347826';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="apple-itunes-app" content="app-id=6740347826" />
    <title>7TV Stickers</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <script is:inline define:vars={{ appStoreUrl }}>
      window.location.replace(appStoreUrl);
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0; url=${appStoreUrl}`} />
    </noscript>
  </head>
  <body style="margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;font-family:-apple-system,system-ui,sans-serif;">
    <a href={appStoreUrl}>
      <img src={`${base}/badges/app-store-black.svg`} alt="Download on the App Store" height="48" />
    </a>
  </body>
</html>
